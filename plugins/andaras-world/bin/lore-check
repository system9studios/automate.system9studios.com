#!/usr/bin/env python3
"""Validate Andara's World canon and design docs in the content repo, and list them.

Source of truth: automate.system9studios.com / plugins/andaras-world/bin/lore-check.
Vendored into target repos as .claude/bin/lore-check. Don't edit it there.

    lore-check [--root <repo>]                   validate; exit 1 on any problem
    lore-check --list [--root <repo>]            print every page: kind, status, title, path
    lore-check --changes <base> [--root <repo>]  print status changes since <base> (e.g. origin/main),
                                                 marking approvals for the owner's review; then validate

Where each kind lives (paths relative to docs/):

    canon         canon/<slug>.md
    tracker       tracker.md
    sheet         sheets/<type>/<slug>.md
    concept       art/CA-NNN-<slug>.md, images art/img/CA-NNN-<letter>.<ext> (Git LFS)
    (inbox)       art/inbox/<any name>.<ext>: images not yet on a sheet (Git LFS), flat, no pages
    house-style   art/house-style.md
    brief         design/briefs/<slug>.md

Every page has frontmatter (title, kind) and its first body line is `**Status:** <state>`.
`draft` and `proposed` are valid everywhere; the approved forms are per kind (APPROVED below).
Only the owner sets an approved status; this tool can't tell who did, so --changes shows it.
"""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

SHEET_TYPES = {"npc", "faction", "item", "creature", "conflict", "mystery", "hook", "zone"}
SLUG = r"[a-z0-9]+(?:-[a-z0-9]+)*"
LAYOUT = [  # (kind, pattern relative to docs/)
    ("canon", re.compile(rf"^canon/{SLUG}\.md$")),
    ("tracker", re.compile(r"^tracker\.md$")),
    ("sheet", re.compile(rf"^sheets/({'|'.join(sorted(SHEET_TYPES))})/{SLUG}\.md$")),
    ("house-style", re.compile(r"^art/house-style\.md$")),
    ("concept", re.compile(rf"^art/CA-\d{{3}}-{SLUG}\.md$")),
    ("brief", re.compile(rf"^design/briefs/{SLUG}\.md$")),
]
OWNED = ("canon/", "tracker.md", "sheets/", "art/", "design/")
IMAGE = re.compile(r"^art/img/(CA-\d{3})-[A-Z]\.(png|jpe?g|webp)$")
INBOX = re.compile(r"^art/inbox/[^/]+\.(png|jpe?g|webp)$", re.I)
DASH = r"\s*[—–-]\s*"
APPROVED = {
    "canon": re.compile(rf"^v\d+\.\d+{DASH}approved canon\b", re.I),
    "sheet": re.compile(r"^approved\b", re.I),
    "brief": re.compile(r"^approved\b", re.I),
    "house-style": re.compile(rf"^HS v\d+{DASH}approved\b", re.I),
}
OPEN = re.compile(r"^(draft|proposed)\b", re.I)
STATUS = re.compile(r"^\*\*Status:\*\*\s*(.+?)\s*$")


def parse(text: str) -> tuple[dict | None, str | None]:
    """Frontmatter dict and the status from the first body line, or None for either."""
    if not text.startswith("---\n"):
        return None, None
    end = text.find("\n---\n", 4)
    if end < 0:
        return None, None
    meta = {}
    for line in text[4:end].splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip().strip("'\"")
    body = [l for l in text[end + 5:].splitlines() if l.strip()]
    m = STATUS.match(body[0]) if body else None
    return meta, (m.group(1) if m else None)


def kind_of(rel: str) -> str | None:
    return next((k for k, pat in LAYOUT if pat.match(rel)), None)


def approved(kind: str, status: str) -> bool:
    return kind in APPROVED and bool(APPROVED[kind].match(status))


def check(docs: Path) -> tuple[list[str], list[tuple[str, str, dict, str]]]:
    problems, pages = [], []
    if (docs / "lore").exists():
        problems.append("docs/lore/ is retired: canon lives in docs/canon/, the tracker in docs/tracker.md")
    if not docs.is_dir():
        return problems, pages
    concepts = set()
    for f in sorted(docs.rglob("*")):
        if not f.is_file():
            continue
        rel = f.relative_to(docs).as_posix()
        if not rel.startswith(OWNED) or rel.startswith(("art/img/", "art/inbox/")):
            continue
        kind = kind_of(rel)
        if kind is None:
            problems.append(f"docs/{rel}: not a known place (see lore-check --help for the layout; slugs are kebab-case)")
            continue
        meta, status = parse(f.read_text())
        if meta is None:
            problems.append(f"docs/{rel}: missing frontmatter (title, kind)")
            continue
        missing = [k for k in ("title", "kind") if not meta.get(k)]
        if missing:
            problems.append(f"docs/{rel}: frontmatter missing {', '.join(missing)}")
            continue
        if meta["kind"] != kind:
            problems.append(f"docs/{rel}: kind '{meta['kind']}' should be '{kind}' here")
        if status is None:
            problems.append(f"docs/{rel}: first line after the frontmatter must be **Status:** <state>")
            continue
        if kind != "tracker" and not (OPEN.match(status) or approved(kind, status)):
            problems.append(f"docs/{rel}: status '{status}' isn't draft, proposed, or this kind's approved form")
        if kind == "concept":
            concepts.add(rel.split("/")[1][:6])
        pages.append((f"docs/{rel}", kind, meta, status))
    img = docs / "art/img"
    if img.is_dir():
        for f in sorted(p for p in img.rglob("*") if p.is_file()):
            rel = f.relative_to(docs).as_posix()
            m = IMAGE.match(rel)
            if not m:
                problems.append(f"docs/{rel}: images are art/img/CA-NNN-<letter>.png|jpg|webp")
            elif m.group(1) not in concepts:
                problems.append(f"docs/{rel}: no concept sheet {m.group(1)}-<slug>.md")
    inbox = docs / "art/inbox"
    if inbox.is_dir():
        for f in sorted(p for p in inbox.rglob("*") if p.is_file()):
            rel = f.relative_to(docs).as_posix()
            if not INBOX.match(rel):
                problems.append(f"docs/{rel}: the inbox holds images only (png|jpg|webp), not in subdirectories")
    return problems, pages


def git(root: Path, *args: str) -> str:
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, check=True).stdout


def changes(root: Path, base: str) -> list[str]:
    out = []
    names = git(root, "diff", "--name-status", "--no-renames", f"{base}...HEAD", "--", "docs").splitlines()
    for line in names:
        st, path = line.split("\t", 1)
        rel = path.removeprefix("docs/")
        kind = kind_of(rel)
        if kind is None:
            continue
        old = new = None
        if st != "A":
            old = parse(git(root, "show", f"{base}:{path}"))[1]
        if st != "D":
            new = parse((root / path).read_text())[1]
        if old == new:
            continue
        mark = "APPROVAL " if new and approved(kind, new) else ""
        out.append(f"{mark}{path}: {old or '(new)'} → {new or '(deleted)'}")
    return out


def repo_root() -> Path:
    try:
        return Path(git(Path.cwd(), "rev-parse", "--show-toplevel").strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return Path.cwd()


def main(argv: list[str]) -> int:
    if "--help" in argv or "-h" in argv:
        print(__doc__)
        return 0
    root = Path(argv[argv.index("--root") + 1]) if "--root" in argv else repo_root()
    problems, pages = check(root / "docs")
    if "--list" in argv:
        print("| Kind | Status | Title | Path |\n|---|---|---|---|")
        for path, kind, meta, status in sorted(pages, key=lambda p: (p[1], p[0])):
            print(f"| {kind} | {status} | {meta['title']} | {path} |")
    if "--changes" in argv:
        base = argv[argv.index("--changes") + 1]
        try:
            for line in changes(root, base):
                print(f"lore-check: {line}")
        except subprocess.CalledProcessError as e:
            problems.append(f"--changes {base}: {e.stderr.strip()}")
    for p in problems:
        print(f"lore-check: {p}", file=sys.stderr)
    if not problems and "--list" not in argv:
        print(f"lore-check: {len(pages)} pages ok")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
