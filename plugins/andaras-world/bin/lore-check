#!/usr/bin/env python3
"""Validate the Andara's World lore mirror (docs/lore/) and write its index.

Source of truth: automate.system9studios.com / plugins/andaras-world/bin/lore-check.
Vendored into target repos as .claude/bin/lore-check. Don't edit it there.

    lore-check [--root <repo>]            validate; exit 1 on any problem
    lore-check --index [--root <repo>]    (re)write docs/lore/README.md, then validate

Each mirrored page is docs/lore/<kind>/<slug>.md with frontmatter:
title, kind (canon|content-sheet|tracker), status, notion_url,
notion_last_edited, synced_at. canon pages need "approved canon" in status,
content sheets need "approved". /lore-sync writes these files; nobody else does.
"""
from __future__ import annotations

import re
import subprocess
import sys
from datetime import datetime
from pathlib import Path

KINDS = {"canon", "content-sheet", "tracker"}
REQUIRED = ("title", "kind", "status", "notion_url", "notion_last_edited", "synced_at")
SLUG = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*\.md$")
INDEX = "README.md"


def frontmatter(text: str) -> dict | None:
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---\n", 4)
    if end < 0:
        return None
    meta = {}
    for line in text[4:end].splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip().strip("'\"")
    return meta


def iso(v: str) -> bool:
    try:
        datetime.fromisoformat(v.replace("Z", "+00:00"))
        return True
    except ValueError:
        return False


def check(lore: Path) -> tuple[list[str], list[tuple[str, dict]]]:
    problems, pages = [], []
    if not lore.is_dir():
        return [f"{lore} does not exist (run /lore-sync)"], pages
    for f in sorted(lore.rglob("*.md")):
        rel = f.relative_to(lore).as_posix()
        if rel == INDEX:
            continue
        parts = rel.split("/")
        if len(parts) != 2 or parts[0] not in KINDS:
            problems.append(f"{rel}: must be <kind>/<slug>.md with kind in {sorted(KINDS)}")
            continue
        if not SLUG.match(parts[1]):
            problems.append(f"{rel}: slug must be kebab-case")
        meta = frontmatter(f.read_text())
        if meta is None:
            problems.append(f"{rel}: missing frontmatter")
            continue
        missing = [k for k in REQUIRED if not meta.get(k)]
        if missing:
            problems.append(f"{rel}: missing {', '.join(missing)}")
            continue
        if meta["kind"] != parts[0]:
            problems.append(f"{rel}: kind '{meta['kind']}' doesn't match directory '{parts[0]}'")
        st = meta["status"].lower()
        if meta["kind"] == "canon" and "approved canon" not in st:
            problems.append(f"{rel}: canon page isn't approved (status: {meta['status']})")
        if meta["kind"] == "content-sheet" and "approved" not in st:
            problems.append(f"{rel}: content sheet isn't approved (status: {meta['status']})")
        for k in ("notion_last_edited", "synced_at"):
            if not iso(meta[k]):
                problems.append(f"{rel}: {k} isn't ISO-8601")
        if not meta["notion_url"].startswith("https://"):
            problems.append(f"{rel}: notion_url isn't a URL")
        pages.append((rel, meta))
    idx = lore / INDEX
    if pages and (not idx.is_file() or idx.read_text() != render_index(pages)):
        problems.append(f"{INDEX} is stale (run lore-check --index)")
    return problems, pages


def render_index(pages: list[tuple[str, dict]]) -> str:
    out = ["# Lore mirror", "",
           "Read-only mirror of approved Andara's World pages in Notion. Written by",
           "`/lore-sync`; never hand-edit. Notion is authoritative.", ""]
    for kind in ("canon", "tracker", "content-sheet"):
        rows = [(r, m) for r, m in pages if m["kind"] == kind]
        if not rows:
            continue
        out += [f"## {kind}", "", "| Page | Status | Notion edited |", "|---|---|---|"]
        out += [f"| [{m['title']}]({r}) | {m['status']} | {m['notion_last_edited']} |" for r, m in rows]
        out.append("")
    return "\n".join(out)


def repo_root() -> Path:
    try:
        return Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                                   text=True, check=True).stdout.strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return Path.cwd()


def main(argv: list[str]) -> int:
    root = Path(argv[argv.index("--root") + 1]) if "--root" in argv else repo_root()
    lore = root / "docs" / "lore"
    if "--index" in argv:
        _, pages = check(lore)
        if pages:
            (lore / INDEX).write_text(render_index(pages))
    problems, pages = check(lore)
    for p in problems:
        print(f"lore-check: {p}", file=sys.stderr)
    if not problems:
        print(f"lore-check: {len(pages)} pages ok")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
